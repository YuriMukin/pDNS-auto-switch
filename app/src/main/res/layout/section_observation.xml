<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Pdns.Card" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/observation_title" android:textAppearance="@style/Text.Pdns.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/observation_hint" android:textAppearance="@style/Text.Pdns.Body" />
        <TextView android:id="@+id/observation_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/observation_stopped" android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/observation_start"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="52dp" android:textAllCaps="false" android:text="@string/observation_start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/observation_stop"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:minHeight="52dp" android:textAllCaps="false" android:text="@string/observation_stop" android:enabled="false" />
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/auto_enabled"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/auto_title" />
        <TextView android:id="@+id/auto_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/auto_stopped"
            android:textAppearance="@style/Text.Pdns.Body" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="@string/auto_pause_label"
            app:helperText="@string/auto_pause_helper">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/pause_duration" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/auto_hint"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/observation_logging"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/observation_logging" />
        <com.google.android.material.button.MaterialButton android:id="@+id/observation_save"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false"
            android:text="@string/observation_save" />
        <com.google.android.material.button.MaterialButton android:id="@+id/observation_clear"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false"
            android:text="@string/observation_clear" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/observation_legend" android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
