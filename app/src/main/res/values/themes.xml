<resources>
    <style name="Theme.PdnsAutoSwitch" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pdns_primary</item>
        <item name="colorOnPrimary">@color/pdns_on_primary</item>
        <item name="colorPrimaryContainer">@color/pdns_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/pdns_on_primary_container</item>
        <item name="colorSecondary">@color/pdns_primary</item>
        <item name="colorOnSecondary">@color/pdns_on_primary</item>
        <item name="colorSecondaryContainer">@color/pdns_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/pdns_on_surface</item>
        <item name="colorSurface">@color/pdns_surface</item>
        <item name="colorSurfaceContainerLow">@color/pdns_card</item>
        <item name="colorSurfaceContainer">@color/pdns_card</item>
        <item name="colorSurfaceVariant">@color/pdns_secondary_container</item>
        <item name="colorSurfaceContainerHighest">@color/pdns_secondary_container</item>
        <item name="colorSurfaceContainerHigh">@color/pdns_secondary_container</item>
        <item name="colorOnSurface">@color/pdns_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/pdns_on_surface_variant</item>
        <item name="colorOutline">@color/pdns_outline</item>
        <item name="colorOutlineVariant">@color/pdns_outline_variant</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialButtonStyle">@style/Widget.Pdns.Button</item>
    </style>

    <style name="Widget.Pdns.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Pdns.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>
    <style name="Text.Pdns.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Pdns.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
